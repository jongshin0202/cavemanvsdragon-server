{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cavemanvsdragon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost",
    "PUBLIC_API_URL": "http://localhost:8787",
    "WEB_APP_URL": "https://www.cavemanvsdragon.com",
    "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
    "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
    "SESSION_TTL_DAYS": "30",
    "PASSWORD_ITERATIONS": "600000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cavemanvsdragon-dev",
      "database_id": "REPLACE_WITH_DEV_DATABASE_ID",
      "migrations_dir": "migrations"
    },
    {
      "binding": "BACKUP_DB",
      "database_name": "cavemanvsdragon-backup-dev",
      "database_id": "REPLACE_WITH_DEV_BACKUP_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "dev": {
      "name": "cavemanvsdragon-api-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "https://www.cavemanvsdragon.com,http://localhost:5173,https://localhost,capacitor://localhost",
        "PUBLIC_API_URL": "https://cavemanvsdragon-api-dev.REPLACE_WITH_SUBDOMAIN.workers.dev",
        "WEB_APP_URL": "https://www.cavemanvsdragon.com",
        "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
        "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
        "SESSION_TTL_DAYS": "30",
        "PASSWORD_ITERATIONS": "600000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cavemanvsdragon-dev",
          "database_id": "REPLACE_WITH_DEV_DATABASE_ID",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BACKUP_DB",
          "database_name": "cavemanvsdragon-backup-dev",
          "database_id": "REPLACE_WITH_DEV_BACKUP_DATABASE_ID"
        }
      ]
    },
    "production": {
      "name": "cavemanvsdragon-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://www.cavemanvsdragon.com,https://localhost,capacitor://localhost",
        "PUBLIC_API_URL": "https://api.cavemanvsdragon.com",
        "WEB_APP_URL": "https://www.cavemanvsdragon.com",
        "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
        "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
        "SESSION_TTL_DAYS": "30",
        "PASSWORD_ITERATIONS": "600000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cavemanvsdragon-production",
          "database_id": "REPLACE_WITH_PRODUCTION_DATABASE_ID",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BACKUP_DB",
          "database_name": "cavemanvsdragon-backup-production",
          "database_id": "REPLACE_WITH_PRODUCTION_BACKUP_DATABASE_ID"
        }
      ]
    }
  }
}
