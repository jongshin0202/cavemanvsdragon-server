{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cavemanvsdragon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost",
    "PUBLIC_API_URL": "http://localhost:8787",
    "WEB_APP_URL": "https://www.cavemanvsdragon.com",
    "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
    "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
    "SESSION_TTL_DAYS": "30",
    "PASSWORD_ITERATIONS": "100000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cavemanvsdragon-dev",
      "database_id": "86c15215-a758-4313-bcb9-4638210a5a4b",
      "migrations_dir": "migrations"
    },
    {
      "binding": "BACKUP_DB",
      "database_name": "cavemanvsdragon-backup-dev",
      "database_id": "8f7596cc-5fb0-417a-a247-0a90d8fd0697"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "dev": {
      "name": "cavemanvsdragon-api-dev",
      "vars": {
        "ENVIRONMENT": "development",
        "ALLOWED_ORIGINS": "https://www.cavemanvsdragon.com,http://localhost:5173,https://localhost,capacitor://localhost",
        "PUBLIC_API_URL": "https://cavemanvsdragon-api-dev.jwshin1.workers.dev",
        "WEB_APP_URL": "https://www.cavemanvsdragon.com",
        "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
        "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
        "SESSION_TTL_DAYS": "30",
        "PASSWORD_ITERATIONS": "100000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cavemanvsdragon-dev",
          "database_id": "86c15215-a758-4313-bcb9-4638210a5a4b",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BACKUP_DB",
          "database_name": "cavemanvsdragon-backup-dev",
          "database_id": "8f7596cc-5fb0-417a-a247-0a90d8fd0697"
        }
      ]
    },
    "production": {
      "name": "cavemanvsdragon-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://www.cavemanvsdragon.com,https://cavemanvsdragon.vercel.app,https://cavemanvsdragon.team2go.co.kr,https://localhost,capacitor://localhost",
        "PUBLIC_API_URL": "https://cavemanvsdragon-api.jwshin1.workers.dev",
        "WEB_APP_URL": "https://www.cavemanvsdragon.com",
        "ANDROID_STORE_URL": "https://www.cavemanvsdragon.com",
        "IOS_STORE_URL": "https://www.cavemanvsdragon.com",
        "SESSION_TTL_DAYS": "30",
        "PASSWORD_ITERATIONS": "100000"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cavemanvsdragon-production",
          "database_id": "16a0a9a0-98c7-4fc1-a1fc-87bf7bb1fa1f",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BACKUP_DB",
          "database_name": "cavemanvsdragon-backup-production",
          "database_id": "57c0df4d-d2dd-47db-ac5d-3608d126510a"
        }
      ]
    }
  }
}
